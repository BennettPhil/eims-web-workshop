# Phoenix is queried from this Node process, not from inside the Phoenix container.
PHOENIX_BASE_URL=http://localhost:6006
# Match the project selected during tracing (the existing test-machine project is workshop).
# With no trace ID, every available trace in this project is inspected.
PHOENIX_PROJECT_NAME=ai_workshop
# Optional when your Phoenix server requires authentication.
PHOENIX_API_KEY=
# The absolute repository path recorded in the trace, not this evals directory.
# Use a project for this repository: batch mode applies the same path to every trace.
REPO_ROOT=/absolute/path/to/your/project

# check-verification.ts uses Phoenix's built-in provider connection (Phoenix >=19.16).
# Save provider credentials in Phoenix admin settings, not in this file/browser storage.
# Select a built-in provider and model, for example openai:your-model-id.
# No provider or model is selected automatically. LLM_* settings are no longer used.
PHOENIX_JUDGE_MODEL=
# --send-to-judge permits Phoenix to send evidence to that provider.
# Batch mode can make a model call for every usable trace, including reruns.
# Traces without usable tool requests are skipped without a model call or annotation.
# The judge checks whether verification was requested, not whether it passed.
