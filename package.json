{
  "name": "ignitis-eims-web-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "preevals:test": "node -e \"if (!require('node:fs').existsSync('evals/typescript/node_modules/@arizeai/phoenix-evals/package.json')) { console.error('Eval dependencies are missing. Run: npm --prefix evals/typescript ci'); process.exit(1); }\"",
    "evals:test": "npm --prefix evals/typescript test",
    "copilot:traced": "node scripts/copilot-traced.mjs",
    "eval:tests": "node evals/typescript/test-command.ts",
    "eval:errors": "node evals/typescript/tool-errors.ts",
    "eval:judge": "node --env-file=evals/typescript/.env evals/typescript/check-verification.ts",
    "typecheck": "npm --prefix evals/typescript run typecheck",
    "test": "npm run evals:test"
  }
}
